  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "vitest": "^1.0.0",
    "jsdom": "^23.0.0",
    "vue-tsc": "^1.8.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "license": "MIT",
  "engines": { "node": ">=18" }
}
