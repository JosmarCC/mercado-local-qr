{
  "name": "mercado-local-qr",
  "version": "1.0.0",
  "description": "Catálogo progresivo MercadoLocal QR - Vue 3 + Vite + TS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
